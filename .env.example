# Backend API (all optional for the default local run)
PORT=3001
# Keep localhost binding for the unauthenticated local V1 server.
# Use a protected reverse proxy and authentication before any shared deployment.
HOST=127.0.0.1

# SQLite database path. Relative paths are resolved from backend/.
DB_PATH=./data/scanner.sqlite

# Browser origin allowed by the API.
CORS_ORIGIN=http://localhost:5173

# Vite reads this root .env. Its /api proxy follows the backend HOST and PORT.
FRONTEND_PORT=5173
# Frontend API base (browser-visible, not a place for secrets).
# Never put provider credentials, tokens, or signing keys in any VITE_* value.
VITE_API_URL=/api

# No provider credentials are supported by V1: the bundled source is mock-only.
# A future provider must read secrets server-side (prefer a secret manager), not from this file or the browser.
